@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(ZLIB)
find_dependency(zstd)
find_dependency(SQLite3)
# CMake ≥ 4.0 renamed SQLite3::SQLite3 → SQLite::SQLite3; create alias for older CMake
if(TARGET SQLite3::SQLite3 AND NOT TARGET SQLite::SQLite3)
    add_library(SQLite::SQLite3 ALIAS SQLite3::SQLite3)
elseif(TARGET SQLite::SQLite3 AND NOT TARGET SQLite3::SQLite3)
    add_library(SQLite3::SQLite3 ALIAS SQLite::SQLite3)
endif()
cmake_policy(SET CMP0167 NEW)
find_dependency(Boost COMPONENTS filesystem thread date_time timer chrono)

if(@BGEN_WITH_S3@)
    find_dependency(AWSSDK COMPONENTS s3)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/bgenTargets.cmake")

check_required_components(bgen)
